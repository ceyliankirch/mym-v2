// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- TES MODÈLES ---

// 📊 Suivi interne léger des pages vues (maison, sans dépendance externe)
model PageView {
  id        String   @id @default(cuid())
  path      String
  sejourId  String?  // renseigné quand la page vue est une fiche séjour
  createdAt DateTime @default(now())

  @@index([path])
  @@index([sejourId])
  @@index([createdAt])
}

model NewsletterContact {
  id        String   @id @default(cuid())
  email     String   @unique
  prenom    String?
  nom       String?
  tags      String[] @default([])
  abonne    Boolean  @default(true) // false = désabonné, exclu des envois
  source    String?  // "manuel", "import"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterCampagne {
  id                 String    @id @default(cuid())
  sujet              String
  htmlContent        String    @db.Text
  statut             String    @default("Brouillon") // Brouillon, Envoyée
  tagsCiblage        String[]  @default([]) // vide = tous les contacts abonnés
  destinatairesCount Int       @default(0)
  envoyeeLe          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ⚙️ Réglages généraux de l'association (une seule ligne, id fixe "main")
model Parametres {
  id            String   @id @default("main")
  ibanAsso      String?
  bicAsso       String?
  titulaireIban String?
  updatedAt     DateTime @updatedAt
}

model Sejour {
  id           String    @id @default(cuid())
  titre        String
  lieu         String?
  dateDebut    DateTime?
  dateFin      DateTime?
  saison       String?
  imageUrl     String?   // Obligatoire pour stocker le lien Vercel Blob
  places       Int       @default(0)
  prix         Float     @default(0)  // tarif principal (montant)
  prixLabel    String?   // libellé du tarif principal (ex: "Chambre double ou twin")
  tarifs       Json?     // tarifs supplémentaires : [{ label: String, montant: Float }]
  montantAssurance Float @default(30) // montant de l'assurance annulation en option (€)
  statut       String    @default("Brouillon")
  enAvant      Boolean   @default(false)
  tranchesAge  String?   // Pour stocker "6-12 ans" par exemple
  shortDescription String?
  programme        String?
  infosPratiques   String?
  adresseComplete  String?
  galerie          String[] // Tableau d'URLs pour tes 10 photos max
  formSchema       String?  // Le JSON du constructeur de formulaire
  documentsRequis  String[] @default([]) // Sous-ensemble du catalogue fixe
  lienPaiementCIC  String?  // Lien de paiement CIC vers lequel rediriger la famille après inscription
  lienPaiementCICValDeMarne String? // Lien de paiement CIC pour le tarif réduit "Habitant du Val-de-Marne"
  createdAt    DateTime  @default(now())
  inscriptions Inscription[]
  albums       Album[]
}

model Album {
  id        String   @id @default(cuid())
  titre     String
  sejourId  String?
  sejour    Sejour?  @relation(fields: [sejourId], references: [id], onDelete: SetNull)
  photos    Photo[]
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  enAvant   Boolean  @default(false) // Affichée dans "Photos à l'affiche" sur la page d'accueil
  createdAt DateTime @default(now())
}

model Client {
  id           String        @id @default(cuid())
  nom          String
  prenom       String?
  email        String?       @unique
  telephone    String?
  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())

  enfants      Enfant[]
  inscriptions Inscription[]
}

model Inscription {
  id          String   @id @default(cuid())
  montantPaye Float    @default(0)
  statut      String   @default("En attente")
  reponsesFormulaire Json? // réponses aux champs du formulaire d'inscription du séjour
  createdAt   DateTime @default(now())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  enfantId    String
  enfant      Enfant   @relation(fields: [enfantId], references: [id])
  sejourId    String
  sejour      Sejour   @relation(fields: [sejourId], references: [id])
}

model Enfant {
  id                String        @id @default(cuid())
  prenom            String
  nom               String
  dateNaissance     DateTime?
  sexe              String?       // "M" ou "F" — détermine la couleur d'assignation (bleu / rose)
  taille            Int?          // en cm
  poids             Int?          // en kg
  pointure          Int?
  allergies         String?
  informationsComplementaires String?
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents         Document[]
  inscriptions      Inscription[]
  createdAt         DateTime      @default(now())
}

model Document {
  id           String   @id @default(cuid())
  type         String   // une des 5 valeurs du catalogue fixe
  url          String?
  resourceType String?  // type Cloudinary de l'asset (image, raw, video) — nécessaire pour le supprimer proprement
  statut       String   @default("MANQUANT") // MANQUANT, EN_COURS, VALIDE
  enfantId     String
  enfant       Enfant   @relation(fields: [enfantId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([enfantId, type])
}

model Animateur {
  id          String   @id @default(cuid())
  nom         String
  role        String   @default("Animateur") // ex: Directeur, Animateur BAFA...
  bio         String?  // Petite description
  ordre       Int?
  imageUrl    String?  // Photo de profil
  createdAt   DateTime @default(now())
}

// 📣 Bibliothèque "Communication" : flyers / posts générés + fichiers importés
model FichierCommunication {
  id          String   @id @default(cuid())
  nom         String
  type        String   @default("import") // "flyer" | "instagram" | "import"
  url         String   // lien Vercel Blob
  mimeType    String?
  taille      Int?     // en octets
  largeur     Int?
  hauteur     Int?
  sejourId    String?  // séjour source (pas de relation stricte : snapshot)
  sejourTitre String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// --- TABLES POUR L'AUTHENTIFICATION (NextAuth) ---

model User {
  id            String    @id @default(cuid())
  nom           String?
  prenom        String?
  email         String?   @unique
  emailVerified DateTime?
  telephone     String?
  password      String?   // Mot de passe crypté
  image         String?
  role          String    @default("PARENT")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  accounts      Account[]
  sessions      Session[]
  client        Client?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}